# Modelo versionável. Copie para .env.local e nunca grave credenciais reais aqui.
# Os scripts db:migrate e db:seed carregam .env.local automaticamente.

# Banco local de desenvolvimento.
# DATABASE_URL: URL do banco libSQL/SQLite. O código usa file:local.db como
# fallback local; em produção, informe a URL do Turso.
DATABASE_URL=file:local.db

# Banco gerenciado (Turso) para produção.
# DATABASE_AUTH_TOKEN: token de acesso do Turso; deixe vazio no banco local.
# Preencha somente no ambiente de deploy; nunca commite valores reais.
# DATABASE_URL=libsql://seu-banco.turso.io
DATABASE_AUTH_TOKEN=

# Autenticação da coordenação (obrigatória para login).
# ADMIN_PASSWORD: senha única da coordenação. Use um valor forte e exclusivo.
# SESSION_SECRET: segredo com no mínimo 32 caracteres. Gere com:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Trocar SESSION_SECRET invalida todas as sessões existentes.
ADMIN_PASSWORD=
SESSION_SECRET=

# URL pública da aplicação, reservada para os links de certificados em etapas
# futuras. A autenticação atual não utiliza esta variável.
APP_URL=http://localhost:3000
